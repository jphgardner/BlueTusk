Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Test-DotNetCompatibilityToolUsage
{
    param([string] $Path, [string] $Command)

    $pattern = '^\s*(?:Usage:|' + [regex]::Escape($Command) + '\s+\S)'
    return Select-String -LiteralPath $Path -Pattern $pattern -CaseSensitive -Quiet
}

function Invoke-DotNetCompatibilityTool
{
    param(
        [object] $Tool,
        [string] $Framework,
        [string] $DotNetPath,
        [string] $RepositoryRoot,
        [string] $SuiteRoot,
        [string] $BuildRoot,
        [string] $Configuration,
        [AllowNull()] [object] $Container
    )

    $packageDirectory = Join-Path $BuildRoot "tool-packages/$Framework/$($Tool.packageId)"
    New-Item -ItemType Directory -Path $packageDirectory -Force | Out-Null
    $project = Join-Path $RepositoryRoot $Tool.project
    $buildLog = Join-Path $SuiteRoot 'build.log'
    $testLog = Join-Path $SuiteRoot 'test.log'
    & $DotNetPath pack $project -c $Configuration --artifacts-path $BuildRoot `
        "-p:BlueTuskRuntimeTargetFrameworks=$Framework" --output $packageDirectory -v:minimal *> $buildLog
    if ($LASTEXITCODE -ne 0) { throw "Packing '$($Tool.packageId)' for $Framework failed. See '$buildLog'." }
    $packages = @(Get-ChildItem -LiteralPath $packageDirectory -File -Filter "$($Tool.packageId).*.nupkg")
    if ($packages.Count -ne 1) { throw "Expected exactly one packed '$($Tool.packageId)' artifact." }
    $package = $packages[0]
    $version = $package.BaseName.Substring($Tool.packageId.Length + 1)

    $nugetConfig = Join-Path $SuiteRoot 'NuGet.Config'
    @"
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="candidate" value="$([Security.SecurityElement]::Escape($packageDirectory))" />
  </packageSources>
</configuration>
"@ | Set-Content -LiteralPath $nugetConfig -Encoding utf8
    $toolPath = Join-Path $BuildRoot "installed-tool/$Framework/$($Tool.packageId)"
    $previousPackages = $env:NUGET_PACKAGES
    try
    {
        # Isolate the tool package cache so an earlier installation of this
        # version cannot substitute a different package for the local artifact.
        $env:NUGET_PACKAGES = Join-Path $BuildRoot 'tool-nuget-cache'
        & $DotNetPath tool install $Tool.packageId --version $version --framework $Framework `
            --tool-path $toolPath --configfile $nugetConfig --no-cache *> (Join-Path $SuiteRoot 'install.log')
        if ($LASTEXITCODE -ne 0) { throw "Installing '$($Tool.packageId)' on $Framework failed. See install.log." }
    }
    finally { $env:NUGET_PACKAGES = $previousPackages }

    $configs = @(Get-ChildItem -LiteralPath (Join-Path $toolPath '.store') -Recurse -File -Filter "$($Tool.packageId).runtimeconfig.json")
    if ($configs.Count -ne 1 -or [IO.Path]::GetFileName($configs[0].Directory.Parent.FullName) -cne $Framework)
    { throw "The installed '$($Tool.packageId)' package did not select the exact $Framework tools asset." }
    $runtime = Get-Content -LiteralPath $configs[0].FullName -Raw | ConvertFrom-Json
    if ($runtime.runtimeOptions.tfm -cne $Framework) { throw 'The selected CLI has a different compiled target framework.' }
    $entrypoint = Join-Path $configs[0].Directory.FullName "$($Tool.packageId).dll"
    if ($null -ne $Container)
    {
        # The Windows shim generated by local dotnet tool install cannot be
        # launched in a Linux container. Run its exact installed entrypoint.
        $containerPath = '/repo/' + [IO.Path]::GetRelativePath($RepositoryRoot, $entrypoint).Replace('\', '/')
        & docker run --rm --mount "type=bind,source=$RepositoryRoot,target=/repo" --workdir /repo `
            --env DOTNET_ROLL_FORWARD=LatestPatch --env DOTNET_ROLL_FORWARD_TO_PRERELEASE=0 `
            $Container.image dotnet $containerPath --help *> $testLog
    }
    else
    {
        $commandName = if ($IsWindows) { "$($Tool.command).exe" } else { $Tool.command }
        & (Join-Path $toolPath $commandName) --help *> $testLog
    }
    $exitCode = $LASTEXITCODE
    if ($exitCode -ne 0 -or -not (Test-DotNetCompatibilityToolUsage -Path $testLog -Command $Tool.command))
    { throw "The installed '$($Tool.command) --help' did not exit zero and print usage information on $Framework. See '$testLog'." }

    $proof = Join-Path $SuiteRoot 'proof'
    New-Item -ItemType Directory -Path $proof -Force | Out-Null
    Copy-Item -LiteralPath $configs[0].FullName, $package.FullName -Destination $proof
    return [pscustomobject]@{
        exitCode = $exitCode; helpLog = $testLog
        package = Join-Path $proof $package.Name
        runtimeConfiguration = Join-Path $proof $configs[0].Name
    }
}

Export-ModuleMember -Function Invoke-DotNetCompatibilityTool, Test-DotNetCompatibilityToolUsage
