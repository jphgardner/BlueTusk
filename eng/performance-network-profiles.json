        { "name": "bandwidth-downstream", "type": "bandwidth", "stream": "downstream", "toxicity": 1.0, "attributes": { "rate": 12500 } },
        { "name": "bandwidth-upstream", "type": "bandwidth", "stream": "upstream", "toxicity": 1.0, "attributes": { "rate": 12500 } }
