  "requiredWorkflows": [
    "build.yml",
    "security.yml",
    "fuzzing.yml",
    "performance.yml",
    "streams-release-endurance.yml",
    "sync-release-endurance.yml"
  ],
  "requiredApprovalEvidence": [
    {
      "id": "independent-release-review",
      "description": "An engineer who did not implement the candidate has completed the release-review handoff."
    },
    {
      "id": "security-review",
      "description": "Threat model, dependency, secret, identity, and supply-chain findings have no unresolved blocker."
    },
    {
      "id": "application-pilot-a",
      "description": "A representative application has completed its documented pilot acceptance criteria."
    },
    {
      "id": "application-pilot-b",
      "description": "A second independently operated application has completed its documented pilot acceptance criteria."
    },
    {
      "id": "website-deployment-acceptance",
      "description": "The selected production host has passed TLS, routing, caching, security-header and representative field Core Web Vitals acceptance."
    },
    {
      "id": "backup-restore-rehearsal",
      "description": "State stores and PostgreSQL recovery have met the declared RPO and RTO in a timed rehearsal."
    },
    {
      "id": "rollback-rehearsal",
      "description": "Package and application rollback has been rehearsed from the immutable candidate."
    },
    {
      "id": "incident-response-game-day",
      "description": "Operators have detected, triaged, mitigated, and documented a representative failure using the shipped telemetry."
    },
    {
      "id": "slo-owner-approval",
      "description": "Named service owners have accepted the V1 SLOs, alert routes, and error-budget policy."
    },
    {
      "id": "maintainer-signoff",
      "description": "The accountable maintainer has approved stable publication for the exact candidate."
    }
  ],
  "minimums": {
    "runtimeMeters": 6,
    "runtimeInstruments": 60,
    "productionSlos": 14,
    "recoveryObjectives": 5,
    "benchmarkFixtures": 21,
    "benchmarkResults": 89,
    "performanceArtifacts": 42,
    "fuzzTargetSeconds": 3600,
    "allocationBudgets": 37,
    "latencyBudgets": 18,
    "streamsEnduranceHours": 72,
    "streamsMinimumTransactions": 100000,
    "syncEnduranceHours": 24,
    "syncMinimumCycles": 100,
    "enduranceDisturbanceRuns": 2,
    "enduranceDisturbancesPerRun": 7
  },
  "requiredFiles": [
    "eng/telemetry-contract.json",
