<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- CVE-2026-120006 is fixed in Aspire.Hosting 13.6.5. -->
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
    <PackageVersion Include="AWSSDK.RDS" Version="4.0.105.3" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageVersion Include="Azure.Core" Version="1.62.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <!-- GHSA-qhrr-8q5h-9q3h affects the version selected transitively by Aspire.Hosting. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <PackageVersion Include="NetTopologySuite.IO.PostGIS" Version="2.1.0" />
    <PackageVersion Include="NATS.Net" Version="3.0.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="Portable.System.DateTimeOnly" Version="9.0.2" />
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.1" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.11" />
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <PropertyGroup>
    <BlueTuskEfCoreVersion Condition="'$(TargetFramework)' == 'net5.0'">5.0.17</BlueTuskEfCoreVersion>
    <BlueTuskEfCoreVersion Condition="'$(TargetFramework)' == 'net6.0'">7.0.20</BlueTuskEfCoreVersion>
    <BlueTuskEfCoreVersion Condition="'$(TargetFramework)' == 'net7.0'">7.0.20</BlueTuskEfCoreVersion>
    <BlueTuskEfCoreVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.34</BlueTuskEfCoreVersion>
    <BlueTuskEfCoreVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.23</BlueTuskEfCoreVersion>
    <BlueTuskEfCoreVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</BlueTuskEfCoreVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(BlueTuskEfCoreVersion)' != ''">
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Relational" Version="$(BlueTuskEfCoreVersion)" />
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Design" Version="$(BlueTuskEfCoreVersion)" />
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="$(BlueTuskEfCoreVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Update="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
    <PackageVersion Update="Grpc.AspNetCore.Server" Version="2.56.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'net7.0'">
    <PackageVersion Update="Grpc.AspNetCore.Server" Version="2.71.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0' or '$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'net7.0'">
    <PackageVersion Update="Parquet.Net" Version="5.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(BlueTuskRuntimeTests)' == 'true' and '$(TargetFramework)' != '' and !$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageVersion Update="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Update="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>
</Project>
