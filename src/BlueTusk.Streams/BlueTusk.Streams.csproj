<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Streams</BlueTuskProductFamily>
    <Description>Transaction-preserving PostgreSQL change streams for BlueTusk.</Description>
    <PackageTags>postgresql;cdc;logical-replication;streaming</PackageTags>
    <NoWarn>$(NoWarn);CA1711</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Streams.props" />

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <ProjectReference Include="..\BlueTusk.Data\BlueTusk.Data.csproj" />
    <ProjectReference Include="..\BlueTusk.Replication.PgOutput\BlueTusk.Replication.PgOutput.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
