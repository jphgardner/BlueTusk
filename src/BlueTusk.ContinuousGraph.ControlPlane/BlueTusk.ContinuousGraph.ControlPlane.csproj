<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>ContinuousGraph</BlueTuskProductFamily>
    <Description>Continuous Graph operational projections for the BlueTusk Control Plane.</Description>
    <PackageTags>postgresql;graph;sql-pgq;control-plane;operations</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\ContinuousGraph.props" />

  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.ContinuousGraph\BlueTusk.ContinuousGraph.csproj" />
    <ProjectReference Include="..\BlueTusk.ControlPlane\BlueTusk.ControlPlane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
  </ItemGroup>
</Project>
