<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Sync</BlueTuskProductFamily>
    <Description>Signed, transaction-preserving webhook destination for BlueTusk Sync.</Description>
    <PackageTags>postgresql;cdc;sync;webhooks;http;hmac</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Sync.props" />

  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.Sync\BlueTusk.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
