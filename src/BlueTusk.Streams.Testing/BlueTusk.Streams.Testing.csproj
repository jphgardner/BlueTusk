<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Streams</BlueTuskProductFamily>
    <Description>Conformance fixtures and deterministic test helpers for BlueTusk Streams.</Description>
    <PackageTags>postgresql;cdc;testing;conformance</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Streams.props" />

  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.Streams\BlueTusk.Streams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
  </ItemGroup>
</Project>
