<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>ControlPlane</BlueTuskProductFamily>
    <Description>Kubernetes custom-resource reconciliation for the BlueTusk Control Plane.</Description>
    <PackageTags>postgresql;cdc;control-plane;kubernetes;operator</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\ControlPlane.props" />

  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.ControlPlane\BlueTusk.ControlPlane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\deploy\kubernetes\operator\*.yaml"
          Pack="true"
          PackagePath="contentFiles/any/any/kubernetes"
          Link="kubernetes/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
