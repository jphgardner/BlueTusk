<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskLegacyDataSourcePublicApi>true</BlueTuskLegacyDataSourcePublicApi>
    <BlueTuskProductFamily>Live</BlueTuskProductFamily>
    <Description>Secure authoritative live-query contracts, keyed diffs, and resumable delivery for BlueTusk.</Description>
    <PackageTags>postgresql;cdc;live-query;realtime</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Live.props" />

  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.Streams\BlueTusk.Streams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <Using Include="BlueTusk.Data.Compatibility.BlueTuskLegacyDataSource" Alias="DbDataSource" />
  </ItemGroup>
</Project>
