    <BlueTuskProductFamily>Streams</BlueTuskProductFamily>
    <Description>Hosted workers, health checks, and dependency injection for BlueTusk Streams.</Description>
    <PackageTags>postgresql;cdc;dependency-injection;hosting;health-checks</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Streams.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
