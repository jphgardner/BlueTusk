<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <BlueTuskProductFamily>Sync</BlueTuskProductFamily>
    <Description>Aspire application-model integration for BlueTusk Sync workers and destinations.</Description>
    <PackageTags>postgresql;cdc;sync;aspire;hosting</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Sync.props" />

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <!-- Security floor for Aspire's transitive MessagePack runtime (GHSA-qhrr-8q5h-9q3h). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
