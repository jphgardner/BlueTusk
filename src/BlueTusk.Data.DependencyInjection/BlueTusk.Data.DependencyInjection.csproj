<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Provider</BlueTuskProductFamily>
    <Description>Dependency injection and health-check integration for the BlueTusk ADO.NET provider.</Description>
    <PackageTags>postgresql;ado.net;dependency-injection;health-checks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <ProjectReference Include="..\BlueTusk.Data\BlueTusk.Data.csproj" />
  </ItemGroup>
</Project>
