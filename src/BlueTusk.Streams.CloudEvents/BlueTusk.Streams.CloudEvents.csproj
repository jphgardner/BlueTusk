<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Streams</BlueTuskProductFamily>
    <Description>Transaction-preserving CloudEvents 1.0 serialization for BlueTusk Streams.</Description>
    <PackageTags>postgresql;cdc;cloudevents;streaming</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Streams.props" />

  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.Streams\BlueTusk.Streams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
