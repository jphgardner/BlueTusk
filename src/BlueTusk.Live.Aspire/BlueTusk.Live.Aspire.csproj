<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <BlueTuskProductFamily>Live</BlueTuskProductFamily>
    <Description>Aspire application-model integration for BlueTusk Live hosts.</Description>
    <PackageTags>postgresql;live-query;aspire;hosting;realtime</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Live.props" />

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <!-- Security floor for Aspire's transitive MessagePack runtime (GHSA-qhrr-8q5h-9q3h). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
