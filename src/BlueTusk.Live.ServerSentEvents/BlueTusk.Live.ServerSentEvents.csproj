<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Live</BlueTuskProductFamily>
    <Description>Server-sent events transport for BlueTusk Live.</Description>
    <PackageTags>postgresql;live-query;sse;realtime</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Live.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\BlueTusk.Live.AspNetCore\BlueTusk.Live.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>

  <Target Name="GenerateLegacyServerSentEventsApiBaseline" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net5.0'">
    <MakeDir Directories="$(IntermediateOutputPath)CompatibilityApi" />
    <WriteLinesToFile
      File="$(IntermediateOutputPath)CompatibilityApi/PublicAPI.Unshipped.txt"
      Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt').Replace('-&gt; Microsoft.AspNetCore.Builder.RouteHandlerBuilder!', '-&gt; Microsoft.AspNetCore.Builder.IEndpointConventionBuilder!'))))"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <AdditionalFiles Remove="PublicAPI.Unshipped.txt" />
      <AdditionalFiles Include="$(IntermediateOutputPath)CompatibilityApi/PublicAPI.Unshipped.txt" />
    </ItemGroup>
  </Target>
</Project>
