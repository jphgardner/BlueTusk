<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <ProjectReference Include="..\BlueTusk.Client\BlueTusk.Client.csproj" />
    <ProjectReference Include="..\BlueTusk.Protocol\BlueTusk.Protocol.csproj" />
    <ProjectReference Include="..\BlueTusk.Security\BlueTusk.Security.csproj" />
    <ProjectReference Include="..\BlueTusk.TypeSystem\BlueTusk.TypeSystem.csproj" />
    <ProjectReference Include="..\BlueTusk.Diagnostics\BlueTusk.Diagnostics.csproj" />
    <ProjectReference Include="..\BlueTusk.Extensions.Abstractions\BlueTusk.Extensions.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskLegacyPublicApi>true</BlueTuskLegacyPublicApi>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsTrimmable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <Description>Native ADO.NET provider for PostgreSQL built on the BlueTusk wire stack.</Description>
  </PropertyGroup>

</Project>
