<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Edge</BlueTuskProductFamily>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <Description>SQLite transactional offline cache, revision fences and durable mutation queue.</Description>
    <PackageTags>sqlite;offline;sync;edge;conflicts;idempotency</PackageTags>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Edge.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <ProjectReference Include="..\BlueTusk.Edge\BlueTusk.Edge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
  </ItemGroup>
</Project>
