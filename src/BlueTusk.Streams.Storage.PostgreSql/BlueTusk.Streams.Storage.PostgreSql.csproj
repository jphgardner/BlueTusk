<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskLegacyDataSourcePublicApi>true</BlueTuskLegacyDataSourcePublicApi>
    <BlueTuskProductFamily>Streams</BlueTuskProductFamily>
    <Description>Production PostgreSQL checkpoint, lease, and relay storage for BlueTusk Streams.</Description>
    <PackageTags>postgresql;cdc;logical-replication;checkpoint;relay</PackageTags>
    <NoWarn>$(NoWarn);CA1711</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Streams.props" />

  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.Streams\BlueTusk.Streams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlueTusk.Sync.DependencyInjection" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <Using Include="BlueTusk.Data.Compatibility.BlueTuskLegacyDataSource" Alias="DbDataSource" />
  </ItemGroup>
</Project>
