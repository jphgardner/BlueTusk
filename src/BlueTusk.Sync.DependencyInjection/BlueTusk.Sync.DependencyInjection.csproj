    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <ProjectReference Include="..\BlueTusk.Streams.Storage.PostgreSql\BlueTusk.Streams.Storage.PostgreSql.csproj" />
    <ProjectReference Include="..\BlueTusk.Sync\BlueTusk.Sync.csproj" />
  </ItemGroup>
</Project>
