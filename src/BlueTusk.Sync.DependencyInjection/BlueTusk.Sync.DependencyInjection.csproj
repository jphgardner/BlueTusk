    <BlueTuskProductFamily>Sync</BlueTuskProductFamily>
    <Description>Hosted workers, cutover coordination, health checks, and dependency injection for BlueTusk Sync.</Description>
    <PackageTags>postgresql;cdc;sync;dependency-injection;hosting;health-checks</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\Sync.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
