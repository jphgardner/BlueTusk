<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary><BlueTuskProductFamily>Edge</BlueTuskProductFamily>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <Description>Bounded source-generated Edge HTTP wire codecs and scoped remote transport.</Description>
    <PackageTags>offline;http;sync;json</PackageTags>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Edge.props" />
  <ItemGroup><ProjectReference Include="..\BlueTusk.Edge\BlueTusk.Edge.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
