<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>ContinuousGraph</BlueTuskProductFamily>
    <Description>Portable PostgreSQL graph queries with bounded incremental maintenance and authoritative Live repair.</Description>
    <PackageTags>postgresql;sql-pgq;graph;live-query;realtime</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\ContinuousGraph.props" />
  <Import Project="..\..\eng\EntityFrameworkCore.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <ProjectReference Include="..\BlueTusk.Data\BlueTusk.Data.csproj" />
    <ProjectReference Include="..\BlueTusk.EntityFrameworkCore\BlueTusk.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\BlueTusk.Live\BlueTusk.Live.csproj" />
    <ProjectReference Include="..\BlueTusk.Streams\BlueTusk.Streams.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
