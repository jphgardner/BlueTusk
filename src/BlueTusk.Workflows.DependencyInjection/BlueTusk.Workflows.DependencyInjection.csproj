<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Workflows</BlueTuskProductFamily>
    <Description>Bounded scoped readiness and typed hosting integration for BlueTusk Workflows.</Description>
    <PackageTags>postgresql;workflows;dependency-injection;health-checks</PackageTags>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Workflows.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <ProjectReference Include="..\BlueTusk.Workflows\BlueTusk.Workflows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
