<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskProductFamily>Edge</BlueTuskProductFamily>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <Description>Durable scoped offline cache and mutation synchronization contracts.</Description>
    <PackageTags>offline;sync;edge;conflicts;idempotency</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BlueTusk.Edge.Sqlite" />
    <InternalsVisibleTo Include="BlueTusk.Edge.LoadHarness" />
    <InternalsVisibleTo Include="BlueTusk.Edge.Tests" />
  </ItemGroup>
  <Import Project="..\..\eng\versions\Edge.props" />
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
