<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <BlueTuskLegacyDataSourcePublicApi>true</BlueTuskLegacyDataSourcePublicApi>
    <BlueTuskProductFamily>Documents</BlueTuskProductFamily>
    <Description>Tenant-scoped typed document transactions and snapshots over BlueTusk Streams.</Description>
    <PackageTags>postgresql;documents;cdc;jsonb</PackageTags>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Documents.props" />
  <ItemGroup>
    <ProjectReference Include="..\BlueTusk.Documents\BlueTusk.Documents.csproj" />
    <ProjectReference Include="..\BlueTusk.Streams\BlueTusk.Streams.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BlueTusk.Data.Compatibility.BlueTuskLegacyDataSource" Alias="DbDataSource" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))" />
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>
</Project>
