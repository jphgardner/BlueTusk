<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BlueTuskProductFamily>Sql</BlueTuskProductFamily>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Sql.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\src\BlueTusk.Sql\BlueTusk.Sql.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Schema\BlueTusk.Schema.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Sql.SourceGeneration\BlueTusk.Sql.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="Queries\*.sql" />
    <AdditionalFiles Include="..\BlueTusk.Sql.Tests\Queries\TypeShapes.sql" />
    <Compile Include="..\BlueTusk.Sql.Tests\TypedShapeVerification.cs" Link="TypedShapeVerification.cs" />
  </ItemGroup>
</Project>
