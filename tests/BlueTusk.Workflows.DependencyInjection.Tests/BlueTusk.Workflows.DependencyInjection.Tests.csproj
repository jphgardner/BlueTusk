<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeTests>true</BlueTuskRuntimeTests>
    <UseAppHost Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</UseAppHost>
    <BlueTuskProductFamily>Workflows</BlueTuskProductFamily>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Workflows.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="xunit.v3" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="xunit" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\BlueTusk.Jobs.DependencyInjection\BlueTusk.Jobs.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Workflows.DependencyInjection\BlueTusk.Workflows.DependencyInjection.csproj" />
    <Compile Include="..\BlueTusk.Workflows.Tests\WorkflowDatabase.cs" Link="WorkflowDatabase.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BlueTusk.Tests.Shared" />
    <Compile Include="..\Shared\RequiredEnvironmentFactAttribute.cs" Link="RequiredEnvironmentFactAttribute.cs" />
  </ItemGroup>
</Project>
