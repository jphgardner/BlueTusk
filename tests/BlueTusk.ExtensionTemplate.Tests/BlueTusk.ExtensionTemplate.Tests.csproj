<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlueTusk.Data\BlueTusk.Data.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Extensions.Abstractions\BlueTusk.Extensions.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Extensions.Testing\BlueTusk.Extensions.Testing.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.TypeSystem\BlueTusk.TypeSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\templates\BlueTusk.Extension\content\src\BlueTusk.Extensions.Sample\*.cs"
             Link="Template\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\templates\BlueTusk.Production\content\.template.config\template.json"
          Link="ProductionTemplate\template.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\templates\BlueTusk.Production\content\compose.yaml"
          Link="ProductionTemplate\compose.yaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\templates\BlueTusk.Production\content\BlueTusk.ProductionStarter.slnx"
          Link="ProductionTemplate\BlueTusk.ProductionStarter.slnx"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\applications\web\order-operations\package.json"
          Link="ProductionTemplate\react-package.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\applications\web\order-operations-angular\package.json"
          Link="ProductionTemplate\angular-package.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
