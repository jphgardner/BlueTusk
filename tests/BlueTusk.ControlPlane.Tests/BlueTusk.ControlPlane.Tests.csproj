<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeTests>true</BlueTuskRuntimeTests>
    <UseAppHost Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</UseAppHost>
    <BlueTuskProductFamily>ControlPlane</BlueTuskProductFamily>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BlueTuskDashboardBrowserTests)' == 'true' or '$(BLUETUSK_DASHBOARD_BROWSER_MODULE)' != ''">
    <DefineConstants>$(DefineConstants);BLUETUSK_DASHBOARD_BROWSER_TESTS</DefineConstants>
  </PropertyGroup>

  <Import Project="..\..\eng\versions\ControlPlane.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="xunit" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlueTusk.ControlPlane\BlueTusk.ControlPlane.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Dashboard\BlueTusk.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Live.Testing\BlueTusk.Live.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\samples\BlueTusk.Samples.Dashboard\BlueTusk.Samples.Dashboard.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="KubernetesTopologyGraphBuilderTests.cs" />
  </ItemGroup>
</Project>
