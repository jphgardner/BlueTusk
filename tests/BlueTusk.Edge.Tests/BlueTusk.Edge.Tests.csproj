<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeTests>true</BlueTuskRuntimeTests>
    <UseAppHost Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</UseAppHost>
    <BlueTuskProductFamily>Edge</BlueTuskProductFamily>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Edge.props" />
  <ItemGroup>
    <Compile Include="..\..\benchmarks\BlueTusk.Edge.LoadHarness\BrowserCheckpointFile.cs" Link="LoadHarness\BrowserCheckpointFile.cs" />
    <None Include="..\..\benchmarks\BlueTusk.Edge.LoadHarness\checkpoint.mjs" Link="checkpoint.mjs" CopyToOutputDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\BlueTusk.Edge.Http\BlueTusk.Edge.Http.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Edge.AspNetCore\BlueTusk.Edge.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Edge.Server\BlueTusk.Edge.Server.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Data\BlueTusk.Data.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="xunit" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\BlueTusk.Edge\BlueTusk.Edge.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Edge.Sqlite\BlueTusk.Edge.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BlueTusk.Tests.Shared" />
    <Compile Include="..\Shared\RequiredEnvironmentFactAttribute.cs" Link="RequiredEnvironmentFactAttribute.cs" />
    <Compile Include="..\Shared\PortableHttpTestHost.cs" Link="PortableHttpTestHost.cs" />
    <Using Include="BlueTusk.Data.Compatibility.BlueTuskLegacyDataSource" Alias="DbDataSource" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))" />
  </ItemGroup>
</Project>
