{
  "schemaVersion": 1,
  "distributionRoot": "dist/website/browser",
  "limits": {
    "initialRawBytes": 950000,
    "initialBrotliBytes": 225280,
    "largestLazyBrotliBytes": 286720,
    "totalDistributionBytes": 20971520
  },
  "minimumPrerenderedRoutes": 135,
  "requiredAssets": [
    "favicon.ico",
    "robots.txt",
    "sitemap.xml",
    "llms.txt",
    "llms-full.txt",
    ".well-known/security.txt"
  ],
  "requiredPrerenderedRoutes": [
    "/",
    "/platform",
    "/provider",
    "/documentation",
    "/documentation/real-time/continuous-graph"
  ],
  "requiredMetadata": [
    "<html lang=\"en\"",
    "<meta name=\"viewport\"",
    "name=\"description\"",
    "<meta name=\"theme-color\"",
    "<meta property=\"og:title\"",
    "property=\"og:description\"",
    "property=\"og:image\"",
    "<meta name=\"twitter:card\"",
    "name=\"robots\"",
    "href=\"/llms.txt\""
  ]
}
