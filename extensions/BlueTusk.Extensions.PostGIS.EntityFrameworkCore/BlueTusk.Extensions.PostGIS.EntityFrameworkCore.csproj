<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="NetTopologySuite" />
    <PackageReference Include="NetTopologySuite.IO.PostGIS" />
    <ProjectReference Include="..\BlueTusk.Extensions.PostGIS\BlueTusk.Extensions.PostGIS.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.EntityFrameworkCore\BlueTusk.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>BlueTusk.Extensions.PostGIS.EntityFrameworkCore</PackageId>
    <Description>Optional NetTopologySuite type mappings, spatial translations, and migration integration for BlueTusk Entity Framework Core.</Description>
    <PackageTags>postgresql;database;dotnet;bluetusk;postgis;spatial;nettopologysuite;entity-framework-core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
