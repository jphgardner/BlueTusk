<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <OutputType>Exe</OutputType>
    <BlueTuskProductFamily>Schema</BlueTuskProductFamily>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bluetusk-schema</ToolCommandName>
    <Description>Bounded PostgreSQL schema capture, canonical snapshot comparison and deployment drift checks.</Description>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Schema.props" />
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
    <ProjectReference Include="..\..\src\BlueTusk.Schema\BlueTusk.Schema.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Data\BlueTusk.Data.csproj" />
    <InternalsVisibleTo Include="BlueTusk.Schema.Tool.Tests" />
  </ItemGroup>
</Project>
