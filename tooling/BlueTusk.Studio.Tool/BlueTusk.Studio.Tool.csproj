<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(BlueTuskRuntimeTargetFrameworks)</TargetFrameworks>
    <BlueTuskRuntimeLibrary>true</BlueTuskRuntimeLibrary>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <BlueTuskProductFamily>Studio</BlueTuskProductFamily>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bluetusk-studio</ToolCommandName>
    <Description>Bounded authenticated operational inspection of BlueTusk Studio.</Description>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Studio.props" />
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
    <InternalsVisibleTo Include="BlueTusk.Studio.Tool.Tests" />
  </ItemGroup>
</Project>
