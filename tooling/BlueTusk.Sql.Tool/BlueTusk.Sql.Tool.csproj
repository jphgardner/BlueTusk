<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <BlueTuskProductFamily>Sql</BlueTuskProductFamily>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bluetusk-sql</ToolCommandName>
    <Description>Explicit PostgreSQL query validation against canonical schema snapshots for offline typed SQL builds.</Description>
  </PropertyGroup>
  <Import Project="..\..\eng\versions\Sql.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\src\BlueTusk.Sql\BlueTusk.Sql.csproj" />
    <ProjectReference Include="..\..\src\BlueTusk.Schema\BlueTusk.Schema.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <Compile Include="..\..\src\BlueTusk.Sql.SourceGeneration\SqlContractModel.cs" Link="Contracts\SqlContractModel.cs" />
    <Compile Include="..\..\src\BlueTusk.Sql.SourceGeneration\SqlValidationDocument.cs" Link="Contracts\SqlValidationDocument.cs" />
    <InternalsVisibleTo Include="BlueTusk.Sql.Tool.Tests" />
  </ItemGroup>
</Project>
