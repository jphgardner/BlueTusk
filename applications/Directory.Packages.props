<Project>
  <Import Project="..\Directory.Packages.props" />
  <PropertyGroup>
    <BlueTuskApplicationPackageVersion Condition="'$(BlueTuskApplicationPackageVersion)' == ''">1.1.0-rc.2</BlueTuskApplicationPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BlueTusk.ContinuousGraph" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.ContinuousGraph.ControlPlane" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.ControlPlane" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Dashboard" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Data" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Data.DependencyInjection" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.EntityFrameworkCore" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.EntityFrameworkCore.Design" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Live" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Live.AspNetCore" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Live.DependencyInjection" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Live.EntityFrameworkCore" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Live.ServerSentEvents" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Live.SignalR" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Streams" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Streams.DependencyInjection" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Streams.EntityFrameworkCore" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Streams.Storage.PostgreSql" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Sync" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Sync.DependencyInjection" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="BlueTusk.Sync.PostgreSql" Version="$(BlueTuskApplicationPackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>
</Project>
