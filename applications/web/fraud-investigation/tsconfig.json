{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "isolatedModules": true,
    "resolveJsonModule": true, "noEmit": true, "jsx": "react-jsx", "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "vite.config.ts"]
}
