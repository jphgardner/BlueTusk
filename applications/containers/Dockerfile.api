FROM mcr.microsoft.com/dotnet/sdk:10.0.302@sha256:72dd743782f2ae7e5476fd64f6a460045e3998dc862218b80e6944cba79a01b0 AS build
ARG PROJECT_FAMILY
WORKDIR /source
COPY Directory.Build.props Directory.Packages.props README.md ./
COPY applications/ applications/
RUN dotnet restore "applications/src/${PROJECT_FAMILY}/BlueTusk.${PROJECT_FAMILY}.Api/BlueTusk.${PROJECT_FAMILY}.Api.csproj" \
    --source https://api.nuget.org/v3/index.json
RUN dotnet publish "applications/src/${PROJECT_FAMILY}/BlueTusk.${PROJECT_FAMILY}.Api/BlueTusk.${PROJECT_FAMILY}.Api.csproj" \
    --configuration Release --no-restore --output /app /p:UseAppHost=false && \
    cp "/app/BlueTusk.${PROJECT_FAMILY}.Api.dll" /app/BlueTusk.Application.Api.dll && \
    cp "/app/BlueTusk.${PROJECT_FAMILY}.Api.deps.json" /app/BlueTusk.Application.Api.deps.json && \
    cp "/app/BlueTusk.${PROJECT_FAMILY}.Api.runtimeconfig.json" /app/BlueTusk.Application.Api.runtimeconfig.json

FROM mcr.microsoft.com/dotnet/aspnet:10.0.10-noble-chiseled@sha256:70d6f993bf715a031f027832a19cfb7f894df66c8b5eb40be0aaee820ad5d119
ARG PROJECT_FAMILY
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_EnableDiagnostics=0 \
    PROJECT_FAMILY=${PROJECT_FAMILY}
WORKDIR /app
COPY --from=build --chown=1654:1654 /app ./
USER 1654:1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "BlueTusk.Application.Api.dll"]
